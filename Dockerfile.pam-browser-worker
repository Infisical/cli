FROM golang:1.26.10-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY main.go ./
COPY packages ./packages
COPY detect ./detect
RUN CGO_ENABLED=0 go build -trimpath -o /out/infisical .

FROM debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc
RUN apt-get update && apt-get install -y --no-install-recommends chromium=156.0.8078.79-1~deb12u1 fonts-liberation ca-certificates && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 worker && useradd --uid 10001 --gid 10001 --create-home worker \
    && mkdir -p /run/pam && chown worker:worker /run/pam
COPY --from=build /out/infisical /usr/local/bin/infisical
ENV INFISICAL_DISABLE_TELEMETRY=1 DO_NOT_TRACK=1
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/infisical"]
